backend/uploads/*
!backend/uploads/.gitkeep

# Ignorar las detecciones procesadas
backend/reconocimiento/detecciones/*
!backend/reconocimiento/detecciones/.gitkeep

# Ignorar recibidos si existe
backend/reconocimiento/recibidos/*

