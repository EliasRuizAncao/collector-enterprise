# --- Dependencias y Entornos ---
node_modules/
.venv/
backend/.venv/
venv/
__pycache__/
*.py[cod]

# --- Variables de Entorno (¡CRÍTICO NO SUBIR ESTO!) ---
.env
.env.local
*.env

# --- Archivos de Build y Logs ---
dist/
build/
